    {
      "parameters": {
        "jsCode": "const volumeScores = {\n  '0-20': 5,\n  '21-50': 10,\n  '51-100': 20,\n  '101-300': 25,\n  '300+': 30,\n};\n\nconst budgetScores = {\n  'Under $500': 5,\n  '$500-$1,500': 15,\n  '$1,500-$5,000': 25,\n  '$5,000+': 30,\n  'Not sure yet': 8,\n};\n\nconst timelineScores = {\n  'Immediately': 25,\n  'Within 30 days': 20,\n  'Within 3 months': 10,\n  'Just exploring': 3,\n};\n\nreturn $input.all().map((item) => {\n  const lead = item.json;\n  let score = 0;\n  const reasons = [];\n\n  const volumeScore = volumeScores[lead.monthly_leads] ?? 0;\n  score += volumeScore;\n\n  if (volumeScore >= 20) {\n    reasons.push('High lead volume');\n  }\n\n  const budgetScore = budgetScores[lead.automation_budget] ?? 0;\n  score += budgetScore;\n\n  if (budgetScore >= 25) {\n    reasons.push('Strong implementation budget');\n  }\n\n  const timelineScore = timelineScores[lead.implementation_timeline] ?? 0;\n  score += timelineScore;\n\n  if (timelineScore >= 20) {\n    reasons.push('High purchase urgency');\n  }\n\n  const challenge = String(lead.main_challenge ?? '').toLowerCase();\n\n  const painKeywords = [\n    'slow',\n    'lose',\n    'lost',\n    'manual',\n    'follow-up',\n    'follow up',\n    'response',\n    'crm',\n    'missed',\n    'qualification',\n  ];\n\n  const hasStrongPain =\n    challenge.length >= 20 &&\n    painKeywords.some((keyword) => challenge.includes(keyword));\n\n  if (hasStrongPain) {\n    score += 15;\n    reasons.push('Clear operational pain');\n  } else if (challenge.length >= 20) {\n    score += 8;\n    reasons.push('Defined business challenge');\n  }\n\n  if (lead.company_name && lead.website) {\n    score += 5;\n    reasons.push('Identifiable business');\n  }\n\n  score = Math.min(score, 100);\n\n  let leadTemperature;\n  let priority;\n  let recommendedAction;\n\n  if (score >= 70) {\n    leadTemperature = 'Hot';\n    priority = 'High';\n    recommendedAction =\n      'Contact within 15 minutes and offer a discovery call';\n  } else if (score >= 45) {\n    leadTemperature = 'Warm';\n    priority = 'Medium';\n    recommendedAction =\n      'Send a relevant case study and follow up within 24 hours';\n  } else {\n    leadTemperature = 'Cold';\n    priority = 'Low';\n    recommendedAction =\n      'Add to a nurture sequence and follow up later';\n  }\n\n  return {\n    json: {\n      ...lead,\n      lead_score: score,\n      lead_temperature: leadTemperature,\n      priority,\n      recommended_action: recommendedAction,\n      qualification_reasons: reasons,\n      scored_at: new Date().toISOString(),\n    },\n  };\n});"
      },
